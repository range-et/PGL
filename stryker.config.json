{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "Src/**/*.ts",
    "!Src/Shaders/**",
    "!Src/SampleData/ZKC*.ts",
    "!Src/SampleData/dwt_1005.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "timeoutMS": 2000
}
